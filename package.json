{
  "name": "uniblox-checkout-rewards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reliable checkout and milestone rewards service",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:domain": "node --test test/domain.test.ts",
    "test:http": "node --test test/http.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
